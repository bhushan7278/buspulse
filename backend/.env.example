PORT=5000
MONGO_URI=your_mongodb_connection_string
FRONTEND_URL=http://localhost:5173
# Configurable public tracking base URL for mobile WhatsApp GPS links
# Never set to localhost for mobile access.
# Development: http://<LAN_IP>:5173 (e.g. http://192.168.1.100:5173)
# Production: https://your-production-domain.com or https://your-tunnel.ngrok-free.app
PUBLIC_TRACKING_URL=http://<YOUR_LAN_IP>:5173
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1h

# Admin Registration Email Configuration (Gmail SMTP)
# Generate a Google Account App Password (16 letters)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_REGISTRATION_EMAIL=your_email@gmail.com
ADMIN_APPROVAL_EMAIL=your_approval_email@example.com

# Admin Registration Policy
ALLOW_ADMIN_REGISTRATION=false
