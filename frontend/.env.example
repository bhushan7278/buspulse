# Public Tracking Base URL for Mobile WhatsApp Links
# Never set to localhost or 127.0.0.1 for mobile access.
# Development: http://<LAN_IP>:5173 (e.g. http://192.168.1.100:5173)
# Production: https://your-production-domain.com or https://your-tunnel.ngrok-free.app
VITE_PUBLIC_TRACKING_URL=http://<YOUR_LAN_IP_OR_DOMAIN>:5173
VITE_API_URL=http://<YOUR_LAN_IP_OR_DOMAIN>:5000
