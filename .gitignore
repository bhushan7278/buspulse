# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Production Artifacts
dist/
dist-ssr/
build/
out/

# Environment and Secrets (ALLOW .env.example)
.env
.env.local
.env.*.local
*.env
!*.env.example
!**/.env.example

# Database Backups, Snapshots & Archives
backups/
.archive/
snapshot-*/
*.dump
*.sql

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor Files
.idea/
.vscode/
*.swp
*.swo
